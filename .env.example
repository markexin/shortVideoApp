# LLM — OpenAI-compatible
# MiniMax Token Plan users can set MINIMAX_API_KEY instead of LLM_API_KEY.
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

# Optional aliases for MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# 工作流类型: comfyui | http
WORKFLOW_PROVIDER=comfyui

# ComfyUI 本地服务
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=examples/短剧视频工作流.json
COMFYUI_IMAGE_WORKFLOW_PATH=examples/短剧图片工作流.json

# 图片生成: comfyui | liblib
IMAGE_PROVIDER=liblib

# liblib.art OpenAPI 生图
LIBLIB_ACCESS_KEY=
LIBLIB_SECRET_KEY=
LIBLIB_BASE_URL=https://openapi.liblibai.cloud
LIBLIB_IMAGE_ENDPOINT=/api/generate/webui/text2img/ultra
LIBLIB_STATUS_ENDPOINT=/api/generate/webui/status
LIBLIB_TEMPLATE_UUID=
LIBLIB_POLL_INTERVAL=3
LIBLIB_TIMEOUT=600

# 如果使用 /api/generate/webui/text2img 普通 SD 文生图，可指定模型
LIBLIB_CHECKPOINT_ID=
LIBLIB_LORA_MODEL_ID=
LIBLIB_LORA_WEIGHT=0.8
LIBLIB_SAMPLER=15
LIBLIB_STEPS=24
LIBLIB_CFG_SCALE=7
LIBLIB_CLIP_SKIP=2
LIBLIB_IMG_COUNT=1

# 可选：按任务类型覆盖 liblib 模型/模板/张数
# 人物参考图
LIBLIB_CHARACTER_IMAGE_ENDPOINT=
LIBLIB_CHARACTER_TEMPLATE_UUID=
LIBLIB_CHARACTER_CHECKPOINT_ID=
LIBLIB_CHARACTER_LORA_MODEL_ID=
LIBLIB_CHARACTER_IMG_COUNT=1

# 场景参考图
LIBLIB_SCENE_IMAGE_ENDPOINT=
LIBLIB_SCENE_TEMPLATE_UUID=
LIBLIB_SCENE_CHECKPOINT_ID=
LIBLIB_SCENE_LORA_MODEL_ID=
LIBLIB_SCENE_IMG_COUNT=1

# 道具参考图
LIBLIB_PROP_IMAGE_ENDPOINT=
LIBLIB_PROP_TEMPLATE_UUID=
LIBLIB_PROP_CHECKPOINT_ID=
LIBLIB_PROP_LORA_MODEL_ID=
LIBLIB_PROP_IMG_COUNT=1

# 分镜图片
LIBLIB_SHOT_IMAGE_ENDPOINT=
LIBLIB_SHOT_TEMPLATE_UUID=
LIBLIB_SHOT_CHECKPOINT_ID=
LIBLIB_SHOT_LORA_MODEL_ID=
LIBLIB_SHOT_IMG_COUNT=1

# 自定义图生视频工作流 HTTP 入口，仅 WORKFLOW_PROVIDER=http 时使用
# 接收 shot_id/image_path/prompt/negative_prompt/duration/aspect_ratio/output_path
WORKFLOW_ENDPOINT=http://127.0.0.1:8000/generate-shot
